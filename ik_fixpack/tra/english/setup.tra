@120 = ~Check the Bodies: Farrahd's banquet journal entry no longer hangs the game~
@121 = ~Needs Check the Bodies installed first.~
@130 = ~Thalantyr Item Upgrade: the Sword of the Murderer's Held icon follows its paralysis~
@131 = ~Needs Thalantyr Item Upgrade installed first.~
@140 = ~Finch NPC: Finch's glasses identify items on the Enhanced Editions~
@141 = ~Needs Finch NPC installed first.~
@150 = ~Thrown Hammers: thrown axe, dagger and hammers add Strength to damage on the Enhanced Editions~
@151 = ~Needs Thrown Hammers' "Normal throwing hammers" or "+1 throwing weapons" installed first.~
