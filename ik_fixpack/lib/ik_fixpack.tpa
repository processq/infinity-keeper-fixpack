// Infinity Keeper Fixpack: shared functions for its components.
//
// Two kinds of component (see README.md):
//   after-patches   fix bad data a mod leaves in the game; installed right after it.
//   replacements    make a working copy of a mod's own install script on the player's machine,
//                   from the author's file plus our line edits, and install from that copy.
//
// This repository never holds another author's files or script text: only our edits.

/*
 * IK_FIXPACK_REPLACE (action function)
 *   Copies the author's install script `source` (a path from the game folder) to `target`, after
 *   checking it is the exact version our edits were written for, then applies `edits`, a .tpp
 *   file of ours that calls IK_FIXPACK_EDIT once per change.
 *
 *   INT_VAR size     the author's file's size in bytes (0: not checked here). Infinity Keeper also
 *                    checks the file's SHA-256 before it runs the result.
 *   STR_VAR source   e.g. ~mymod/setup-mymod.tp2~
 *           target   where the copy goes: in the game folder's top, under the author's file name,
 *                    e.g. ~setup-mymod.tp2~. WeiDU v251 runs a tp2 only from the top or from a
 *                    folder named like it (util.ml:963-972, case_exact_tp_file), matches installed
 *                    scripts by file name only (tpstate.ml:209-213), so other mods' MOD_IS_INSTALLED
 *                    and REQUIRE_COMPONENT checks still find the mod, and takes MOD_FOLDER for a
 *                    top-level script from its BACKUP line (util.ml:932-946), the author's folder.
 *                    A script whose BACKUP names another folder (or one that already sits at the
 *                    top) goes in the mod's own folder under the other form of its name instead
 *                    (setup-mymod.tp2 <-> mymod.tp2), which WeiDU matches the same way.
 *           edits    e.g. ~ik_fixpack/fixes/mymod/edits.tpp~
 */
DEFINE_ACTION_FUNCTION IK_FIXPACK_REPLACE
  INT_VAR size = 0
  STR_VAR source = ~~ target = ~~ edits = ~~
BEGIN
  ACTION_IF NOT FILE_EXISTS ~%source%~ BEGIN
    FAIL @1001
  END
  ACTION_IF size > 0 AND (SIZE_OF_FILE ~%source%~ != size) BEGIN
    FAIL @1002
  END
  COPY ~%source%~ ~%target%~
    PATCH_INCLUDE ~%edits%~
END

/*
 * IK_FIXPACK_EDIT (patch function)
 *   One of our changes to the copy: `old` must appear exactly once, and becomes `new`. Anything
 *   else stops the component, so an edit never lands in the wrong place of another version.
 */
DEFINE_PATCH_FUNCTION IK_FIXPACK_EDIT
  STR_VAR old = ~~ new = ~~
BEGIN
  SET first = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~)
  PATCH_IF first < 0 BEGIN
    PATCH_FAIL @1003
  END
  PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~ (first + 1))) >= 0 BEGIN
    PATCH_FAIL @1004
  END
  SET old_length = STRING_LENGTH ~%old%~
  DELETE_BYTES first old_length
  INSERT_BYTES first (STRING_LENGTH ~%new%~)
  WRITE_ASCIIE first ~%new%~
END

/*
 * IK_FIXPACK_FIX_TOKEN (action function)
 *   In the dialogues whose names match `files` (a regexp, e.g. ~^r#allis\.dlg$~), every state's,
 *   reply's and journal entry's text holding `old` (a misspelled token such as <LORDLADY>, which the
 *   game shows as written) gets `new` in its place, in the game's string table (STRING_SET, which
 *   WeiDU undoes on uninstall). Only texts holding `old` change; the dialogues themselves don't.
 */
DEFINE_ACTION_FUNCTION IK_FIXPACK_FIX_TOKEN
  STR_VAR files = ~~ old = ~~ new = ~~
BEGIN
  COPY_EXISTING_REGEXP GLOB ~%files%~ ~override~
    READ_LONG 0x08 ik_states
    READ_LONG 0x0c ik_state_at
    READ_LONG 0x10 ik_replies
    READ_LONG 0x14 ik_reply_at
    // A state's text is its first word; a reply's text (flag bit 0) and journal entry (bit 4) are
    // its second and third (IESDP DLG V1.0).
    FOR (ik_i = 0; ik_i < ik_states + 2 * ik_replies; ++ik_i) BEGIN
      PATCH_IF ik_i < ik_states BEGIN
        SET ik_at = ik_state_at + 0x10 * ik_i
        SET ik_has = 1
      END ELSE BEGIN
        SET ik_r = (ik_i - ik_states) / 2
        READ_LONG (ik_reply_at + 0x20 * ik_r) ik_flags
        SET ik_journal = (ik_i - ik_states) MODULO 2
        SET ik_at = ik_reply_at + 0x20 * ik_r + 4 + 4 * ik_journal
        SET ik_has = ik_journal ? ((ik_flags BAND 0x10) != 0) : ((ik_flags BAND 0x1) != 0)
      END
      PATCH_IF ik_has BEGIN
        READ_SLONG ik_at ik_ref
        PATCH_IF ik_ref >= 0 BEGIN
          READ_STRREF ik_at ik_text
          PATCH_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~%old%~ ~%ik_text%~)) >= 0 BEGIN
            INNER_PATCH_SAVE ik_text ~%ik_text%~ BEGIN
              REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%old%~ ~%new%~
            END
            INNER_ACTION BEGIN
              STRING_SET_EVALUATE ik_ref ~%ik_text%~
            END
          END
        END
      END
    END
  BUT_ONLY
END

/*
 * IK_FIXPACK_EDIT_EACH (patch function)
 *   Like IK_FIXPACK_EDIT for a text the author repeats (the same game check in each component):
 *   from `after` on (a text that must appear exactly once; empty: the whole file), `old` must
 *   appear exactly `count` times, and each becomes `new`. Anything else stops the component.
 */
DEFINE_PATCH_FUNCTION IK_FIXPACK_EDIT_EACH
  INT_VAR count = 1
  STR_VAR old = ~~ new = ~~ after = ~~
BEGIN
  SET ik_from = 0
  PATCH_IF NOT ~%after%~ STRING_EQUAL ~~ BEGIN
    SET ik_from = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%after%~)
    PATCH_IF ik_from < 0 BEGIN
      PATCH_FAIL @1003
    END
    PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%after%~ (ik_from + 1))) >= 0 BEGIN
      PATCH_FAIL @1004
    END
  END
  SET ik_found = 0
  SET ik_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~ ik_from)
  WHILE ik_at >= 0 BEGIN
    SET ik_found += 1
    SET ik_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~ (ik_at + 1))
  END
  PATCH_IF ik_found != count BEGIN
    PATCH_FAIL @1005
  END
  SET ik_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~ ik_from)
  WHILE ik_at >= 0 BEGIN
    DELETE_BYTES ik_at (STRING_LENGTH ~%old%~)
    INSERT_BYTES ik_at (STRING_LENGTH ~%new%~)
    WRITE_ASCIIE ik_at ~%new%~
    SET ik_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%old%~ (ik_at + STRING_LENGTH ~%new%~))
  END
END

/*
 * IK_FIXPACK_IDS_ADD_MISSING (action function)
 *   Adds to the IDS list `ids` (e.g. ~stats.ids~) each line of `from` (a value and a name, as in
 *   an IDS list) whose name `ids` doesn't already have. Nothing is reordered or removed, so every
 *   name other mods or scripts already use keeps its value. A line break goes at the end of `ids`
 *   first, so an added line never joins its last line.
 */
DEFINE_ACTION_FUNCTION IK_FIXPACK_IDS_ADD_MISSING
  STR_VAR ids = ~~ from = ~~
BEGIN
  COPY_EXISTING ~%ids%~ ~override~
    PATCH_IF BUFFER_LENGTH > 0 BEGIN
      READ_BYTE (BUFFER_LENGTH - 1) ik_last
      PATCH_IF ik_last != 10 BEGIN
        SET ik_end = BUFFER_LENGTH
        INSERT_BYTES ik_end 2
        WRITE_ASCIIE ik_end ~%WNL%~
      END
    END
  BUT_ONLY
  COPY - ~%from%~ ~override~
    READ_2DA_ENTRIES_NOW ik_ids_rows 2
    FOR (ik_r = 0; ik_r < ik_ids_rows; ++ik_r) BEGIN
      READ_2DA_ENTRY_FORMER ik_ids_rows ik_r 0 ik_value
      READ_2DA_ENTRY_FORMER ik_ids_rows ik_r 1 ik_name
      INNER_ACTION BEGIN
        APPEND ~%ids%~ ~%ik_value% %ik_name%~ UNLESS ~[ %TAB%]%ik_name%[ %TAB%%MNL%]*$~
      END
    END
END
